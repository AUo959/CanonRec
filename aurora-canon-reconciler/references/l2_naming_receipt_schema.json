{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.local/schemas/l2-naming-receipt-v1.0.json",
  "title": "CanonRec L2 Naming Admission Contract",
  "type": "object",
  "oneOf": [
    {"required": ["naming_receipt"]},
    {"required": ["naming_exemption"]}
  ],
  "properties": {
    "naming_receipt": {
      "type": "object",
      "required": [
        "protocol",
        "receipt_version",
        "canonical_name",
        "signature",
        "rejected_candidates",
        "collisions_checked",
        "request",
        "registry_digest",
        "candidate_set",
        "selection_mode"
      ],
      "properties": {
        "protocol": {"const": "GUMAS_NAMING_PROTOCOL_v0.1"},
        "receipt_version": {"const": "1.0"},
        "canonical_name": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "signature": {
          "type": "object",
          "required": [
            "normalized",
            "root",
            "phonetic_key",
            "cadence",
            "seed"
          ],
          "properties": {
            "normalized": {"type": "string"},
            "root": {"type": "string"},
            "phonetic_key": {"type": "string"},
            "cadence": {"type": "object"},
            "seed": {"type": "integer"}
          }
        },
        "rejected_candidates": {"type": "array"},
        "collisions_checked": {"type": "integer", "minimum": 0},
        "request": {
          "type": "object",
          "required": ["entity_type", "entity_id", "register"],
          "properties": {
            "entity_type": {
              "enum": [
                "PERSON",
                "FACTION",
                "TREATY",
                "CONFLICT",
                "SHIP",
                "LOCATION",
                "OPERATION",
                "CUSTOM"
              ]
            },
            "entity_id": {"type": "string", "minLength": 1},
            "faction_context": {"type": ["string", "null"]},
            "region_context": {"type": ["string", "null"]},
            "register": {
              "enum": ["FORMAL", "INFORMAL", "CALLSIGN", "BUREAUCRATIC"]
            },
            "constraints": {"type": "object"},
            "seed_hint": {"type": ["integer", "null"]}
          }
        },
        "registry_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_set": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "selection_mode": {
          "enum": [
            "generated",
            "candidate",
            "owner_selected_from_candidates",
            "owner_locked_existing"
          ]
        }
      }
    },
    "naming_exemption": {
      "type": "object",
      "required": ["type", "reason", "authority", "source_refs"],
      "properties": {
        "type": {
          "enum": [
            "owner_locked",
            "recovered_source",
            "legacy_canonical",
            "external_endonym"
          ]
        },
        "reason": {"type": "string", "minLength": 1},
        "authority": {"type": "string", "minLength": 1},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        }
      }
    }
  }
}
